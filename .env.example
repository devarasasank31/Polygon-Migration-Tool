# =============================================================================
# Polygon Migration Tool - Environment Configuration
# =============================================================================
# Copy this file to .env (same directory as this file, at the repository root)
# and fill in your values:
#   cp .env.example .env
#
# Settings are read from PolygonMigration/.env first, then the repository root
# .env. IMPORTANT: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Django Settings
# -----------------------------------------------------------------------------

# Generate a new secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-generate-a-new-one

# Set to True for development, False for production
DEBUG=True

# Comma-separated list of allowed hosts
# For local development: localhost,127.0.0.1
# For production: your-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
#
# Local setup with Docker (docker-compose.yml maps Postgres to host port 5433
# by default to avoid clashing with a natively installed PostgreSQL on 5432):
#   docker compose up -d postgres
#
# Then use these settings:
DB_NAME=polygon_migration
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# -----------------------------------------------------------------------------
# Redis Cache (used to cache fetched Polygon test cases for 30 minutes)
# -----------------------------------------------------------------------------
#
# Local setup with Docker:
#   docker compose up -d redis
#
# Then use these settings:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=False

# For Azure Redis or other cloud Redis with SSL:
# REDIS_HOST=your-redis.redis.cache.windows.net
# REDIS_PORT=6380
# REDIS_PASSWORD=your-redis-password
# REDIS_SSL=True

# -----------------------------------------------------------------------------
# Polygon API Credentials
# -----------------------------------------------------------------------------
#
# Get your API credentials from Polygon:
# 1. Log in to https://polygon.codeforces.com/
# 2. Go to Settings (top-right menu)
# 3. Find "API" section
# 4. Generate new API key
#
POLYGON_API_KEY=your-polygon-api-key
POLYGON_API_SECRET=your-polygon-api-secret

# -----------------------------------------------------------------------------
# Cloud Storage Configuration
# -----------------------------------------------------------------------------
#
# The tool supports two providers behind one interface (see DOCUMENTATION.md):
#   minio - S3-compatible storage (MinIO, AWS S3, Cloudflare R2, ...)
#   azure - Azure Blob Storage (requires an AAD application with
#           username/password credentials)
#
# Select the provider:
STORAGE_PROVIDER=minio

# --- MinIO / S3-compatible storage (default for local development) ---
# Local setup with Docker (creates the bucket automatically on first start):
#   docker compose up -d minio
# Web console: http://localhost:9001 (minioadmin / minioadmin)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=testcases
# Set to False when the endpoint is served over plain HTTP (local development)
MINIO_SECURE=False

# --- AWS S3 (same provider, different endpoint/credentials) ---
# MINIO_ENDPOINT=s3.us-east-1.amazonaws.com
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key
# MINIO_BUCKET_NAME=your-bucket-name
# MINIO_SECURE=True

# --- Azure Blob Storage ---
# AZURE_STORAGE_ACCOUNT_URL=https://youraccount.blob.core.windows.net
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_USERNAME=your-azure-username
# AZURE_PASSWORD=your-azure-password
# AZURE_CONTAINER_NAME=testcases

# -----------------------------------------------------------------------------
# Staff Superuser (used by `python manage.py create_staff_superuser`)
# -----------------------------------------------------------------------------
#
# On first run, set these and execute the command to create the initial staff
# account non-interactively (or run `python manage.py createsuperuser` and fill
# in the fields interactively).
#
# SUPERUSER_EMAIL=admin@example.com
# SUPERUSER_PASSWORD=change-me
# SUPERUSER_USERNAME=admin
# SUPERUSER_FIRST_NAME=Admin
# SUPERUSER_LAST_NAME=User

# -----------------------------------------------------------------------------
# Custom Checker Compilation (optional)
# -----------------------------------------------------------------------------
#
# Directory for compiling custom checkers (optional)
# If not set, uses system temp directory
# Requires g++ compiler installed on your system
#
# CUSTOM_CHECKER_DIR=/path/to/checker/directory

# -----------------------------------------------------------------------------
# Quick Start Commands
# -----------------------------------------------------------------------------
#
# 1. Start infrastructure:
#    docker compose up -d
#
# 2. Apply migrations:
#    python PolygonMigration/manage.py migrate
#
# 3. Create superuser (interactive, or use create_staff_superuser with the
#    SUPERUSER_* variables above):
#    python PolygonMigration/manage.py createsuperuser
#
# 4. Run server:
#    python PolygonMigration/manage.py runserver
#
# 5. Access app:
#    http://localhost:8000/
